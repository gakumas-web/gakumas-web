# 公开项目白名单；未列出的个人数据、构建产物与临时文件默认忽略。
/*
!/.gitignore
!/.dockerignore
!/LICENSE
!/README.md
!/THIRD_PARTY.md
!/SECURITY.md
!/Dockerfile
!/compose.yaml
!/package.json
!/index.html
!/app.mjs
!/style.css
!/application/
!/domain/
!/ui/
!/locales/
!/tests/
!/tools/
!/deploy/
!/docs/
!/.github/
!/resources/
/resources/*
!/resources/content-source.json
!/resources/pages-source.json
!/resources/asset-lock.json
!/resources/*.example.json
__pycache__/
*.pyc
*.log
*.pem
*.p12
*.pcap*
*.gakumas.json
snapshot.json
.env*
node_modules/

!/i18n.mjs
!/resources.mjs
!/image-config.mjs
!/content-config.mjs

!/requirements-test.txt
