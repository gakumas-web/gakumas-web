{
  "name": "gakumas-web",
  "version": "0.5.0-preview",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "python3 -B tools/build.py",
    "preview": "python3 -B -m http.server 8080 --bind 127.0.0.1 --directory dist",
    "build:local": "python3 -B tools/build.py --asset-lock local/asset-lock.json --content-lock local/content-lock.json",
    "content:local": "python3 -B tools/install_content.py --lock local/content-lock.json --asset-lock local/asset-lock.json --output dist"
  },
  "engines": {
    "node": ">=22"
  }
}
